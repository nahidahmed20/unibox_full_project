
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|server\.php)$ - [F,L,NC]
    
    RewriteRule ^(app|bootstrap|config|database|resources|storage|tests|vendor|routes|tools|node_modules|ninetyspoint\.com)(/.*)?$ - [F,L,NC]
    RewriteRule ^public/ - [L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
